---
import { translate, type Copy, type Language } from '../../lib/explore/model';
interface Props { locale: Language; kind: 'face' | 'eye' | 'eeg' | 'emg' }
const { locale, kind } = Astro.props;
const t = (copy: Copy) => translate(copy, locale);
const titles = {face: ['面部动作：从图像到 AU','Facial action: image to AU'], eye: ['眼动：从瞳孔到注视','Eye tracking: pupil to gaze'], eeg: ['脑电：从电极到频段','EEG: electrodes to frequency bands'], emg: ['肌电：从握松到信号','EMG: grip and release to signals']} as const;
const steps = {
 face: [['定位人脸','Locate the face'],['连接关键点','Connect landmarks'],['提取动作单元','Extract action units']],
 eye: [['定位眼部','Locate the eyes'],['识别瞳孔与反光','Detect pupil and glint'],['校准并分析注视','Calibrate and analyze gaze']],
 eeg: [['头皮电极采集','Scalp electrodes'],['检查与处理信号','Inspect and process signals'],['提取频段指标','Extract band measures']],
 emg: [['手臂电极采集','Arm electrodes'],['记录握松变化','Record grip and release'],['对齐脑电时间','Align with EEG time']]
} as const;
const descriptions = {
 face: [['摄像机记录面部图像，算法先定位人脸区域。','A camera records the face; the algorithm locates its region.'],['沿眉、眼、鼻、口定位关键点，跟踪面部形态的变化。','Landmarks around the brows, eyes, nose and mouth track changes in facial geometry.'],['AU 是面部动作单元。例如 AU43 对应闭眼；动作强度随时间形成记录。这里说明提取原理，报告的闭眼指标见结果页。','AU means action unit. AU43 describes eye closure; action intensity forms a time series. This explains extraction; the reported eye-closure measure appears in the results.']],
 eye: [['眼动仪的摄像机获取眼部图像，定位双眼。','Eye-tracker cameras capture eye images and locate the eyes.'],['近红外照明下，算法识别瞳孔中心与角膜反光点。图中圈线为识别原理示意。','With near-infrared illumination, algorithms detect the pupil center and corneal reflections. The overlay illustrates this principle.'],['经过校准，把眼部特征映射到注视位置，再分析注视次数、持续时间和目标区域分配。本报告展示注视次数；瞳孔大小也可作为独立参数记录。','After calibration, eye features map to gaze positions for fixation count, duration and target-area analysis. This report presents fixation counts; pupil size can also be recorded separately.']],
 eeg: [['头皮电极相对参考电极记录微小电位差，经放大与数字化形成通道。','Scalp electrodes record small voltage differences relative to a reference, followed by amplification and digitization.'],['检查接触质量、眨眼和肌肉活动等伪迹，再分析可用时间段。示意波形不代表参与者原始数据。','Inspect contact quality and artifacts such as blinks and muscle activity, then analyze usable periods. These traces are illustrative, not participant recordings.'],['从时域信号分析频段功率，再计算 α/β、θ/α 等比值，与实验时间对齐。报告中的实际比值可在结果页逐段比较。','Analyze frequency-band power and calculate ratios such as alpha/beta and theta/alpha, aligned with study time. Actual reported ratios can be compared in the results.']],
 emg: [['手臂表面电极记录肌肉活动相关的电位变化，经采集设备形成信号。','Surface electrodes on the arm record voltage changes associated with muscle activity.'],['握紧与放松时，肌肉电活动呈现不同变化；经过信号检查和处理，形成可对照的活动记录。','Gripping and releasing change muscle electrical activity; signal inspection and processing produce comparable records.'],['把肌电与脑电对齐在同一时间轴上，观察动作活动与脑部电活动的关系，不凭单一动作判断已经入睡。','Align EMG and EEG on one time axis to examine their relationship, without inferring sleep from one movement alone.']]
} as const;
const facePaths=['M 213 150 Q 218 60 295 53 Q 375 60 387 150','M 213 150 L 223 218 L 250 268 L 296 293 L 343 268 L 377 218 L 387 150','M 226 131 L 248 126 L 278 133 M 312 132 L 341 126 L 366 130','M 235 154 L 255 146 L 274 154 L 255 161 Z M 319 154 L 337 146 L 355 154 L 337 161 Z','M 296 157 L 282 211 L 313 211 Z','M 267 241 L 296 232 L 328 241 L 297 255 Z'];
const wave = (offset: number, burst: boolean) => Array.from({length:181},(_,i)=>`${i?'L':'M'} ${30+i*3} ${offset+Math.sin(i*1.9)*(burst ? (i%60<28?20:3) : 8)+Math.sin(i*.3)*5}`).join(' ');
---
<details class="measurement" data-measurement={kind} data-step="1">
 <summary>{t(titles[kind])}<span aria-hidden="true">＋</span></summary>
 <div class="measurement-content">
  <p class="measurement-caption">{t(['测量原理动画 · 图像与波形为示意','Measurement animation · illustrative images and traces'])}</p>
  <div class={'measurement-image measurement-'+kind}>
   <img src={import.meta.env.BASE_URL+'assets/explore/'+(kind==='emg'?'during.webp':'measurement-face.webp')} alt={t(kind==='emg'?['手臂与握球动作的情境图','Illustrative arm and grip task']:['用于解释测量过程的虚构人物正面图像','Fictional frontal portrait illustrating measurement'])} width="1536" height="1024" loading="lazy"/>
   <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
    {kind==='face' && <><rect class="measure-mark layer-1" x="207" y="50" width="186" height="246" rx="6"/><g class="layer-2">{facePaths.map(d=><path pathLength="1000" class="measure-line" d={d}/>)}{[[235,154],[255,146],[274,154],[319,154],[337,146],[355,154],[296,157],[282,211],[313,211],[267,241],[296,232],[328,241],[297,255]].map(([cx,cy])=><circle class="measure-dot" cx={cx} cy={cy} r="3"/>)}</g><g class="layer-3"><path pathLength="1000" class="measure-line measure-gold" d="M 355 154 L 450 145 L 565 145"/><text x="453" y="134">AU43 · EYES CLOSED</text><path pathLength="1000" class="measure-line measure-gold" d="M 235 154 L 150 145 L 35 145"/><text x="35" y="133">ACTION UNIT</text></g></>}
    {kind==='eye' && <><g class="layer-1"><rect class="measure-mark" x="227" y="136" width="54" height="34"/><rect class="measure-mark" x="312" y="136" width="52" height="34"/></g><g class="layer-2">{[257,336].map(cx=><><circle class="measure-mark" cx={cx} cy="153" r="9"/><circle class="measure-dot" cx={cx} cy="153" r="2"/><circle class="measure-gold" cx={cx+5} cy="149" r="3"/></>)}<path pathLength="1000" class="measure-line" d="M 336 153 L 425 110 L 555 110"/><text x="428" y="98">PUPIL / GLINT</text></g><g class="layer-3"><rect class="gaze-screen" x="375" y="235" width="200" height="130"/><text x="390" y="263">A H R A K</text><text x="390" y="300">K A N H R</text><text x="390" y="339">R H A K A</text><path pathLength="1000" class="measure-line measure-gold" d="M 399 258 L 461 296 L 530 258 L 487 334"/>{[[399,258],[461,296],[530,258],[487,334]].map(([cx,cy],i)=><circle class="fixation-ring" style={'--point:'+i} cx={cx} cy={cy} r="12"/>)}</g></>}
    {(kind==='eeg'||kind==='emg') && <><g class="layer-1">{(kind==='eeg'?[[240,110],[300,90],[360,110]]:[[349,201],[372,204]]).map(([cx,cy])=><><circle class="electrode" cx={cx} cy={cy} r="10"/><path pathLength="1000" class="measure-line" d={`M ${cx} ${cy} Q ${cx+70} ${cy-60} 535 185`}/></>)}<rect class="gaze-screen" x="495" y="165" width="80" height="38"/><text x="508" y="189">{kind.toUpperCase()}</text></g><g class="layer-2"><rect class="signal-panel" x="20" y="290" width="560" height="95"/><text x="30" y="309">{kind==='eeg'?'EEG · TIME':'EMG · GRIP / RELEASE'}</text><path pathLength="1000" class="measure-line signal-trace" d={wave(342,kind==='emg')}/></g><g class="layer-3"><rect class="gaze-screen" x="25" y="30" width="240" height="48"/><text x="40" y="60">{kind==='eeg'?'α / β     θ / α':'EMG ↔ EEG · TIME'}</text>{kind==='eeg' ? <g class="band-bars">{[32,52,24].map((height,i)=><><rect x={40+i*64} y={155-height} width="32" height={height}/><text x={49+i*64} y="172">{['θ','α','β'][i]}</text></>)}</g> : <><rect class="signal-panel" x="20" y="210" width="560" height="77"/><text x="30" y="228">EEG · SAME TIME</text><path pathLength="1000" class="measure-line signal-trace" d={wave(258,false)}/><path pathLength="1000" class="measure-line measure-gold" d="M 298 235 L 298 378"/></>}</g></>}
   </svg>
  </div>
  <div class="measurement-steps" role="group" aria-label={t(['展开测量步骤','Reveal measurement steps'])}>{steps[kind].map((label,i)=><button type="button" data-measure-step={i+1} aria-pressed={i===0?'true':'false'}><span>0{i+1}</span>{t(label)}</button>)}</div>
  <div class="measurement-explanation" aria-live="polite">{descriptions[kind].map((copy,i)=><p data-measure-copy={i+1}>{t(copy)}</p>)}</div>
 </div>
</details>
