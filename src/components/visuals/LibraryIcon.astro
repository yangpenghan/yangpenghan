---
interface Props { name: 'reframe' | 'observe' | 'experiment' | 'knowledge' | 'agent' | 'evidence' | 'iterate' | 'decide'; }
const { name } = Astro.props;
---
<span class="library-icon" aria-hidden="true">
	<img class="light" src={`${import.meta.env.BASE_URL}assets/brand/personal-icons/structures/compact/color/${name}.svg`} alt="" width="32" height="32" loading="lazy" />
	<img class="dark" src={`${import.meta.env.BASE_URL}assets/brand/personal-icons/structures/compact/inverse/${name}.svg`} alt="" width="32" height="32" loading="lazy" />
</span>
<style>
.library-icon { display: inline-block; flex: 0 0 auto; width: 2rem; height: 2rem; }
.library-icon img { width: 100%; height: 100%; }
.library-icon .dark { display: none; }
:global(.theme-dark) .library-icon .light { display: none; }
:global(.theme-dark) .library-icon .dark { display: block; }
</style>
