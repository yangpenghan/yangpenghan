---
import type { CollectionEntry } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n';
import { noteKindLabels } from '../i18n/resources';

interface Props {
	notes: Array<CollectionEntry<'notes'>>;
	locale: Locale;
	compact?: boolean;
}

const { notes, locale, compact = false } = Astro.props;
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const formatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', {
	year: 'numeric',
	month: locale === 'zh' ? 'numeric' : 'short',
	day: '2-digit',
});
---

<ol class:list={["note-list", { compact }]}>
	{
		notes.map((note) => {
			const slug = note.id.split('/').slice(1).join('/');
			return (
				<li data-reveal data-note-search={`${note.data.title} ${note.data.description} ${note.data.categoryLabel}`}>
					<a href={navUrl(`/notes/${slug}/`)}>
						<span class="note-meta">
							<span>{note.data.categoryLabel}</span>
							<time datetime={(note.data.updatedDate ?? note.data.publishDate).toISOString()}>{note.data.updatedDate && `${t('notes.updated')} `}{formatter.format(note.data.updatedDate ?? note.data.publishDate)}</time>
							<span>{noteKindLabels[note.data.kind][locale]}</span>
                            <span>{note.data.readingMinutes} {t('notes.minutes')}</span>
						</span>
						<strong>{note.data.title}</strong>
						<span class="note-description">{note.data.description}</span>
						<span class="note-action">{t('notes.read')} <span aria-hidden="true">→</span></span>
					</a>
				</li>
			);
		})
	}
</ol>

<style>
	.note-list {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		padding: 0;
		border-top: 1px solid var(--rule-strong);
		list-style: none;
	}

	.note-list li {
		border-right: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
	}

	.note-list li:nth-child(3n) {
		border-right: 0;
	}

	.note-list a {
		display: flex;
		min-height: 100%;
		flex-direction: column;
		gap: 1.5rem;
		padding: clamp(1.5rem, 3vw, 2.5rem);
		text-decoration: none;
		transition: background var(--duration) ease;
	}

	.note-list a:hover {
		background: var(--paper-raised);
	}

	.note-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.9rem;
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
	}

	.note-meta span:first-child {
		color: var(--signal-dark);
	}

	.note-list strong {
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.025em;
		line-height: 1.12;
		text-wrap: balance;
	}

	.note-description {
		color: var(--ink-soft);
		font-size: 0.9rem;
		line-height: 1.65;
	}

	.note-action {
		margin-top: auto;
		padding-top: 1rem;
		font-size: 0.8rem;
		font-weight: 700;
	}

	.note-action span {
		display: inline-block;
		margin-left: 0.4rem;
		color: var(--signal-dark);
		transition: transform var(--duration) var(--ease-out);
	}

	.note-list a:hover .note-action span {
		transform: translateX(0.25rem);
	}

	@media (max-width: 56rem) {
		.note-list {
			grid-template-columns: 1fr;
		}

		.note-list li {
			border-right: 0;
		}
	}
.compact { grid-template-columns: 1fr; }
    .compact li { border-right: 0; }
    .compact a { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: .5rem 1.5rem; padding: 1.25rem .5rem; }
    .compact .note-meta { grid-column: 1 / -1; font-size: .875rem; }
    .compact .note-meta > span:first-child { display: none; }
    .compact strong { font-size: clamp(1.15rem, 1.1rem + .3vw, 1.4rem); line-height: 1.45; text-wrap: pretty; }
    .compact .note-description { grid-column: 1; }
    .compact .note-action { grid-column: 2; grid-row: 2; padding: 0; align-self: center; }
    @media (max-width:48rem) { .compact a { grid-template-columns: minmax(0,1fr); gap: .5rem; } .compact .note-action { display: none; } }
</style>
