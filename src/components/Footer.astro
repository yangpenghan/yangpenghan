---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const year = new Date().getFullYear();
const homeUrl = getRelativeLocaleUrl(locale, '');
---

<footer>
	<div class="page-shell footer-grid">
		<div class="footer-mark">
			<a href={homeUrl} aria-label={`${t('nav.brand')} — ${t('nav.home')}`}>WY</a>
			<p>{t('footer.tagline')}</p>
		</div>

		<div class="footer-meta">
			<p>{t('footer.privacy')}</p>
			<p>© {year} {t('footer.copyright')}</p>
		</div>

		<div class="footer-links">
			<a href="https://github.com/yangpenghan" rel="me">{t('footer.github')}</a>
			<a href="https://www.linkedin.com/in/thereisawillyang" rel="me">{t('footer.linkedin')}</a>
			<a href="mailto:yangpenghan1988@gmail.com">{t('footer.email')}</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding-block: 3rem 6.5rem;
		border-top: 1px solid var(--rule);
		background: var(--paper-deep);
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr auto;
		gap: 2rem;
		align-items: end;
	}

	.footer-mark {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	.footer-mark > a {
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		border: 1px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: -0.08em;
		text-decoration: none;
	}

	.footer-mark p {
		max-width: 28rem;
		font-family: var(--font-serif);
		font-size: var(--step-1);
		line-height: 1.3;
	}

	.footer-meta {
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		line-height: 1.7;
	}

	.footer-links {
		display: flex;
		gap: 1rem;
	}

	.footer-links a {
		font-size: 0.82rem;
		font-weight: 650;
		text-underline-offset: 0.25em;
	}

	.footer-links a:hover {
		color: var(--signal-dark);
	}

	@media (max-width: 48rem) {
		.footer-grid {
			grid-template-columns: 1fr;
		}

		.footer-meta {
			order: 3;
		}

		.footer-links {
			flex-wrap: wrap;
		}
	}
</style>
