---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import BrandIdentity from '../BrandIdentity.astro';
import ContactCTA from '../ContactCTA.astro';
import ProblemMap from '../visuals/ProblemMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';
import { getRelatedNoteSlugs, readingPaths } from '../../i18n/reading-paths';

interface Props {
	entry: CollectionEntry<'notes'>;
	locale: Locale;
}

const { entry, locale } = Astro.props;
const { Content, headings } = await render(entry);
const contents = headings.filter((heading) => heading.depth === 2);
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const formatter = new Intl.DateTimeFormat(locale === 'zh' ? 'zh-CN' : 'en-GB', {
	year: 'numeric', month: locale === 'zh' ? 'long' : 'long', day: 'numeric',
});
const allNotes = (await getCollection('notes'))
	.filter((note) => note.data.locale === locale)
	.sort((a, b) => (b.data.updatedDate ?? b.data.publishDate).valueOf() - (a.data.updatedDate ?? a.data.publishDate).valueOf() || a.id.localeCompare(b.id));
const currentSlug = entry.id.split('/').slice(1).join('/');
const readingPath = readingPaths.find((path) => path.slugs.includes(currentSlug));
const relatedNotes = getRelatedNoteSlugs(currentSlug)
	.map((slug) => allNotes.find((note) => note.id === `${locale}/${slug}`))
	.filter((note): note is CollectionEntry<'notes'> => note !== undefined);
const currentIndex = allNotes.findIndex((note) => note.id === entry.id);
const nextNote = relatedNotes[0] ?? allNotes[(currentIndex + 1) % allNotes.length];
const nextSlug = nextNote.id.split('/').slice(1).join('/');
const relatedProject = entry.data.relatedWork
	? (await getCollection('work')).find((project) => {
		const slug = project.id.split('/').slice(1).join('/');
		return project.data.locale === locale && slug === entry.data.relatedWork;
	})
	: undefined;
const modifiedDate = entry.data.updatedDate ?? entry.data.publishDate;
const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: entry.data.title,
	description: entry.data.description,
	datePublished: entry.data.publishDate.toISOString(),
	dateModified: modifiedDate.toISOString(),
	inLanguage: locale === 'zh' ? 'zh-CN' : 'en',
	author: {
		'@type': 'Person',
		name: locale === 'zh' ? '杨朋翰' : 'Will Yang',
		url: 'https://yangpenghan.github.io/yangpenghan/',
	},
};
---

<BaseLayout
	{locale}
	title={`${entry.data.title} | ${locale === 'zh' ? '杨朋翰' : 'Will Yang'}`}
	description={entry.data.description}
	type="article"
	publishedTime={entry.data.publishDate}
	{structuredData}
>
	<main>
		<header class="note-hero page-shell">
			<a class="back-link" href={navUrl('/notes/')} data-reveal><span aria-hidden="true">←</span> {t('notes.back')}</a>
			<div class="note-title" data-reveal>
				<div class="note-meta">
					<span>{entry.data.categoryLabel}</span>
					<time datetime={entry.data.publishDate.toISOString()}>{formatter.format(entry.data.publishDate)}</time>
					<span>{entry.data.readingMinutes} {t('notes.minutes')}</span>
				</div>
				<h1>{entry.data.title}</h1>
				<p>{entry.data.description}</p>
			</div>
		</header>

		<div class="note-body page-shell section-rule">
			<aside class="note-sidebar">
				<span class="author-mark"><BrandIdentity /></span>
				<div>
					<strong>{locale === 'zh' ? '杨朋翰' : 'Will Yang'}</strong>
					<p>{t('index.heroRole')}</p>
				</div>
				<div class="update">
					<small>{t('notes.updated')}</small>
					<time datetime={modifiedDate.toISOString()}>{formatter.format(modifiedDate)}</time>
				</div>
				{contents.length >= 3 && (
					<details class="note-toc" open>
						<summary>{t('notes.contents')}</summary>
						<nav aria-label={t('notes.contents')}>
							<ol>{contents.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
						</nav>
					</details>
				)}
			</aside>
			<article class="prose" data-reveal>
				{entry.id.endsWith('/every-problem-is-technical') && <div class="argument-visual"><ProblemMap {locale} /></div>}
				<Content />
			</article>
		</div>
		{readingPath && relatedNotes.length > 1 && (
			<section class="related-ideas page-shell" aria-labelledby="related-ideas-title">
				<p class="eyebrow">{t('notes.relatedIdeas')}</p>
				<h2 id="related-ideas-title">{readingPath.title[locale]}</h2>
				<p>{readingPath.description[locale]}</p>
				<ul>{relatedNotes.slice(1).map((note) => (
					<li><a href={navUrl(`/notes/${note.id.split('/').slice(1).join('/')}/`)}>{note.data.title}<span aria-hidden="true"> ↗</span></a></li>
				))}</ul>
				<a class="text-link" href={`${navUrl('/notes/')}#${readingPath.id}`}>{t('notes.readingPaths')}</a>
			</section>
		)}

		{relatedProject && (
			<section class="related-work section-rule">
				<a class="page-shell" href={navUrl(`/work/${entry.data.relatedWork}/`)} data-reveal>
					<span>{t('notes.relatedWork')}</span>
					<strong>{relatedProject.data.title}</strong>
					<p>{relatedProject.data.description}</p>
					<span aria-hidden="true">↗</span>
				</a>
			</section>
		)}

		<nav class="next-note section-rule" aria-label={t('notes.next')}>
			<a class="page-shell" href={navUrl(`/notes/${nextSlug}/`)}>
				<span>{t('notes.next')}</span>
				<strong>{nextNote.data.title}</strong>
				<span aria-hidden="true">→</span>
			</a>
		</nav>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.note-sidebar { position: sticky; top: calc(var(--header-height) + 2rem); align-self: start; max-height: calc(100dvh - var(--header-height) - 4rem); overflow-y: auto; padding: .3rem; }
	.note-toc { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--rule); }
	.note-toc summary { cursor: pointer; color: var(--ink); font-weight: 650; }
	.note-toc ol { padding-left: 1.25rem; margin-top: 1rem; display: grid; gap: .75rem; }
	.note-toc a { text-decoration: none; display: block; overflow-wrap: anywhere; }
	.note-toc a:hover { color: var(--signal-dark); text-decoration: underline; text-underline-offset: .2em; }
	.related-ideas { padding-bottom: clamp(3rem, 7vw, 5rem); }
	.related-ideas h2 { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.3; margin-block: 1rem; }
	.related-ideas > p:not(.eyebrow) { color: var(--ink-soft); max-width: 44rem; }
	.related-ideas ul { display: grid; gap: 1rem; padding-left: 1.25rem; margin-block: 1.5rem; }
	.related-ideas li a { color: var(--ink); text-underline-offset: .2em; }
 .argument-visual { max-width: 32rem; margin: 0 auto 3rem; }
	.note-hero {
		padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 11vw, 10rem);
	}

	.back-link {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--ink-soft);
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
	}

	.back-link:hover { color: var(--signal-dark); }

	.note-title {
		width: min(100%, 68rem);
		margin-top: clamp(4rem, 9vw, 8rem);
		margin-inline: auto;
	}

	.note-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.2rem;
		margin-bottom: 2rem;
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.note-meta span:first-child { color: var(--signal-dark); }

	h1 {
		max-width: 24ch;
		font-family: var(--font-display);
		font-size: clamp(2.8rem, 5.2vw, 4.9rem);
		line-height: 1.15;
	}

	.note-title > p {
		max-width: 44rem;
		margin-top: 2.5rem;
		color: var(--ink-soft);
		font-size: var(--step-1);
	}

	.note-body {
		display: grid;
		grid-template-columns: minmax(10rem, 14rem) minmax(0, 48rem);
		justify-content: center;
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: clamp(5rem, 11vw, 10rem);
	}

	.note-body aside {
		display: grid;
		align-content: start;
		gap: 1rem;
		color: var(--ink-soft);
		font-size: 0.72rem;
		line-height: 1.5;
	}

	.author-mark {
		display: grid;
		width: 3rem;
		height: 3rem;
		place-items: center;
		padding: .2rem;
		color: var(--ink);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
	}

	.note-body aside strong { color: var(--ink); }

	.update {
		display: grid;
		gap: 0.15rem;
		margin-top: 1rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		text-transform: uppercase;
	}

	.note-body article { max-width: 48rem; }

	.next-note a {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(3rem, 7vw, 6rem);
		text-decoration: none;
	}

	.related-work {
		background: var(--paper-deep);
	}

	.related-work a {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr) minmax(14rem, 0.55fr) auto;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		text-decoration: none;
	}

	.related-work a > span:first-child {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.related-work strong {
		font-family: var(--font-display);
		font-size: var(--step-2);
		line-height: 1.15;
	}

	.related-work p {
		color: var(--ink-soft);
		font-size: 0.82rem;
	}

	.related-work a > span:last-child {
		color: var(--signal-dark);
		font-size: 1.4rem;
	}

	.next-note a > span:first-child {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.next-note strong {
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	.next-note a > span:last-child {
		color: var(--signal-dark);
		font-size: 2rem;
		transition: transform var(--duration) var(--ease-out);
	}

	.next-note a:hover > span:last-child { transform: translateX(0.5rem); }

	@media (max-width: 56rem) {
		.note-body { grid-template-columns: 1fr; }
		.note-sidebar { position: static; max-height: none; overflow: visible; }
		.note-toc { grid-column: 1 / -1; }
		.note-body aside { grid-template-columns: auto 1fr; }
		.update { grid-column: 1 / -1; }
		.related-work a { grid-template-columns: minmax(0, 1fr) auto; }
		.related-work a > span:first-child,
		.related-work p { grid-column: 1 / -1; }
	}

	@media (max-width: 42rem) {
		h1 { font-size: clamp(2.1rem, 9vw, 3.5rem); }
		.next-note a { grid-template-columns: minmax(0, 1fr) auto; }
		.next-note a > span:first-child { grid-column: 1 / -1; }
	}
</style>
