---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ContactCTA from '../ContactCTA.astro';
import ResourceLinks from '../ResourceLinks.astro';
import { workResources } from '../../i18n/resources';
import CaseDiagram from '../visuals/CaseDiagram.astro';
import PublicSlide from '../visuals/PublicSlide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
	entry: CollectionEntry<'work'>;
	locale: Locale;
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const statusLabel = entry.data.status === 'prototype'
	? t('work.legendPrototype')
	: entry.data.status === 'operating'
		? t('work.legendOperating')
		: t('work.legendDelivered');
const displayStatus = entry.data.statusText ?? statusLabel;
const allProjects = (await getCollection('work'))
	.filter((project) => project.data.locale === locale)
	.sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((project) => project.id === entry.id);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
const nextSlug = nextProject.id.split('/').slice(1).join('/');
const entrySlug = entry.id.split('/').slice(1).join('/');
const diagramKinds: Record<string, 'evidence' | 'iteration' | 'interaction'> = { 'financial-behavior-model': 'evidence', 'medical-devices': 'iteration', 'human-robot-interaction': 'interaction' };
const diagramKind = diagramKinds[entrySlug];
const relatedNotes = (await getCollection('notes'))
	.filter((note) => note.data.locale === locale && note.data.relatedWork === entrySlug)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
	.slice(0, 3);
const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: entry.data.title,
	description: entry.data.description,
	author: { '@type': 'Person', name: locale === 'zh' ? '杨朋翰' : 'Will Yang' },
	datePublished: entry.data.publishDate.toISOString(),
	dateModified: (entry.data.updatedDate ?? entry.data.publishDate).toISOString(),
};
---

<BaseLayout
	{locale}
	title={`${entry.data.title} | ${locale === 'zh' ? '杨朋翰' : 'Will Yang'}`}
	description={entry.data.description}
	type="article"
	publishedTime={entry.data.publishDate}
	{structuredData}
>
	<main>
		<header class="case-hero page-shell">
			<a class="back-link" href={navUrl('/work/')} data-reveal><span aria-hidden="true">←</span> {t('workDetail.back')}</a>
			<div class="case-title-grid">
				<div data-reveal>
					<div class="case-meta">
						<span>{displayStatus}</span><span>{entry.data.year}</span><span>{entry.data.discipline}</span>
					</div>
					<h1>{entry.data.title}</h1>
				</div>
				<div class="case-dek" data-reveal>
					<p>{entry.data.description}</p>
                    <p class="role-summary">{t('workDetail.role')} · {entry.data.role}</p>
                    {workResources[entrySlug]?.length > 0 && <a class="text-link internal" href="#materials">{locale === 'zh' ? '取用方法模板' : 'Get the method templates'}</a>}
					{entry.data.externalUrl && <a class="text-link" href={entry.data.externalUrl}>{t('workDetail.sourceLabel')}</a>}
					{entry.data.sourceUrl && <a class="text-link" href={entry.data.sourceUrl}>{t('workDetail.sourceCodeLabel')}</a>}
				</div>
			</div>
		</header>

		<div class="case-body page-shell">
			<aside class="case-aside" data-reveal>
                <div class="facts-grid">
                    <div><small>{t('workDetail.role')}</small><p>{entry.data.role}</p></div>
                    <div><small>{t('workDetail.outcome')}</small><p>{entry.data.outcome}</p></div>
                    <div><small>{t('workDetail.tagsLabel')}</small><p>{entry.data.tags.join(' · ')}</p></div>
                </div>
				{entry.data.confidentiality && (
					<div class="confidentiality">
						<small>{t('workDetail.note')}</small>
						<p>{entry.data.confidentiality}</p>
					</div>
				)}
			</aside>
			<article class="prose" data-reveal>
				<Content />
                {diagramKind && <div class="inline-visual"><CaseDiagram {locale} kind={diagramKind} id={`detail-${entrySlug}`} /></div>}
			</article>
		</div>

        {workResources[entrySlug]?.length > 0 && <div class="page-shell"><ResourceLinks {locale} ids={workResources[entrySlug]} /></div>}

		{entrySlug === 'medical-devices' && <section class="source-section page-shell section-rule" aria-label={locale === 'zh' ? '公开演讲材料' : 'Public presentation material'}><PublicSlide {locale} /></section>}

		{relatedNotes.length > 0 && (
			<section class="related-thinking section-rule" aria-labelledby="related-title">
				<div class="page-shell related-grid">
					<header data-reveal><p class="eyebrow">Notes / Thinking</p><h2 id="related-title">{t('workDetail.related')}</h2></header>
					<ul>
						{relatedNotes.map((note) => {
							const slug = note.id.split('/').slice(1).join('/');
							return <li data-reveal><a href={navUrl(`/notes/${slug}/`)}><span>{note.data.categoryLabel} · {note.data.readingMinutes} min</span><strong>{note.data.title}</strong><span aria-hidden="true">→</span></a></li>;
						})}
					</ul>
				</div>
			</section>
		)}

		<nav class="next-project section-rule" aria-label={t('workDetail.next')}>
			<a class="page-shell" href={navUrl(`/work/${nextSlug}/`)}>
				<span>{t('workDetail.next')}</span>
				<strong>{nextProject.data.title}</strong>
				<span aria-hidden="true">→</span>
			</a>
		</nav>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
 .inline-visual { margin-top: 3rem; }
 .role-summary { font-size: .875rem; }
 .source-section { padding-block: 4rem; }
	.case-hero {
		padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(2rem, 4vw, 3rem);
	}

	.back-link {
		display: inline-flex;
		gap: 0.6rem;
		align-items: center;
		color: var(--ink-soft);
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--signal-dark);
	}

	.case-title-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
		gap: clamp(1.5rem, 4vw, 4rem);
		align-items: end;
		margin-top: 1.5rem;
	}

	.case-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-bottom: 1.75rem;
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.case-meta span:first-child {
		color: var(--signal-dark);
	}

	h1 {
		max-width: 24ch;
		overflow-wrap: anywhere;
		font-family: var(--font-display);
		font-size: clamp(2.1rem,3.5vw,3.5rem);
		line-height: 1.15;
	}

	.case-dek {
		display: grid;
		justify-items: start;
		gap: 1rem;
		color: var(--ink-soft);
		font-size: var(--step-0);
	}

	.facts-grid {
		display: grid;
		grid-template-columns: 1fr;
        gap: 1.5rem;
	}

	.facts-grid > div {
		display: grid;
		gap: 0.85rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--rule);
	}

	.facts-grid > div:first-child { padding-left: 0; }
	.facts-grid > div:last-child { padding-right: 0; border-right: 0; }

	.facts-grid small,
	.confidentiality small {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.facts-grid p {
		font-size: 0.95rem;
		line-height: 1.55;
	}

	.case-body {
		display: grid;
		grid-template-columns: minmax(12rem, .35fr) minmax(0, 1fr);
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: 2rem 3rem;
	}

	.case-aside {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.confidentiality {
		display: grid;
		gap: 0.8rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule-strong);
		color: var(--ink-soft);
		font-size: 0.875rem;
		line-height: 1.55;
	}

	.case-body article {
		max-width: 44rem;
	}

	.next-project a {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr) auto;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(3rem, 7vw, 6rem);
		text-decoration: none;
	}

	.related-thinking {
		padding-block: clamp(4rem, 9vw, 8rem);
		background: var(--paper-deep);
	}

	.related-grid {
		display: grid;
		grid-template-columns: minmax(14rem, 0.45fr) minmax(0, 1fr);
		gap: clamp(1.5rem, 4vw, 4rem);
	}

	.related-grid h2 {
		margin-top: 1.5rem;
		font-family: var(--font-display);
		font-size: var(--step-3);
	}

	.related-grid ul {
		padding: 0;
		border-top: 1px solid var(--rule-strong);
		list-style: none;
	}

	.related-grid li {
		border-bottom: 1px solid var(--rule);
	}

	.related-grid a {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 0.75rem 2rem;
		padding-block: 1.5rem;
		text-decoration: none;
	}

	.related-grid a > span:first-child {
		grid-column: 1 / -1;
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.64rem;
		text-transform: uppercase;
	}

	.related-grid strong {
		font-family: var(--font-display);
		font-size: var(--step-1);
		line-height: 1.2;
	}

	.related-grid a > span:last-child {
		color: var(--signal-dark);
	}

	.next-project a > span:first-child {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.next-project strong {
		font-family: var(--font-display);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.025em;
	}

	.next-project a > span:last-child {
		color: var(--signal-dark);
		font-size: 2rem;
		transition: transform var(--duration) var(--ease-out);
	}

	.next-project a:hover > span:last-child {
		transform: translateX(0.5rem);
	}

	@media (max-width: 56rem) {
		.case-title-grid,
		.case-body,
		.related-grid {
			grid-template-columns: 1fr;
		}

		.case-aside {
            order: 2;
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: start;
		}

		.facts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.facts-grid > div,
		.facts-grid > div:first-child,
		.facts-grid > div:last-child {
			padding: 0 0 1.5rem;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}

		.facts-grid > div:last-child {
			padding-bottom: 0;
			border-bottom: 0;
		}
	}

	@media (max-width: 42rem) {
		h1 {
			font-size: clamp(1.9rem, 7vw, 2.7rem);
		}

		.case-aside {
			grid-template-columns: 1fr;
		}

		.next-project a {
			grid-template-columns: minmax(0, 1fr) auto;
		}

		.next-project a > span:first-child {
			grid-column: 1 / -1;
		}
	}
</style>
