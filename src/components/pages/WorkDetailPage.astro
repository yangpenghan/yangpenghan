---
import { getCollection, type CollectionEntry, render } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ContactCTA from '../ContactCTA.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
	entry: CollectionEntry<'work'>;
	locale: Locale;
}

const { entry, locale } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const statusLabel = entry.data.status === 'prototype'
	? t('work.legendPrototype')
	: entry.data.status === 'operating'
		? t('work.legendOperating')
		: t('work.legendDelivered');
const allProjects = (await getCollection('work'))
	.filter((project) => project.data.locale === locale)
	.sort((a, b) => a.data.order - b.data.order);
const currentIndex = allProjects.findIndex((project) => project.id === entry.id);
const nextProject = allProjects[(currentIndex + 1) % allProjects.length];
const nextSlug = nextProject.id.split('/').slice(1).join('/');
const structuredData: Record<string, unknown> = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: entry.data.title,
	description: entry.data.description,
	author: { '@type': 'Person', name: locale === 'zh' ? '杨朋翰' : 'Will Yang' },
	datePublished: entry.data.publishDate.toISOString(),
	dateModified: (entry.data.updatedDate ?? entry.data.publishDate).toISOString(),
};
---

<BaseLayout
	{locale}
	title={`${entry.data.title} | ${locale === 'zh' ? '杨朋翰' : 'Will Yang'}`}
	description={entry.data.description}
	type="article"
	publishedTime={entry.data.publishDate}
	{structuredData}
>
	<main>
		<header class="case-hero page-shell">
			<a class="back-link" href={navUrl('/work/')} data-reveal><span aria-hidden="true">←</span> {t('workDetail.back')}</a>
			<div class="case-title-grid">
				<div data-reveal>
					<div class="case-meta">
						<span>{statusLabel}</span><span>{entry.data.year}</span><span>{entry.data.discipline}</span>
					</div>
					<h1>{entry.data.title}</h1>
				</div>
				<div class="case-dek" data-reveal>
					<p>{entry.data.description}</p>
					{entry.data.externalUrl && <a class="text-link" href={entry.data.externalUrl}>GitHub / Public source</a>}
				</div>
			</div>
		</header>

		<section class="case-facts section-rule">
			<div class="page-shell facts-grid">
				<div data-reveal><small>{t('workDetail.role')}</small><p>{entry.data.role}</p></div>
				<div data-reveal><small>{t('workDetail.outcome')}</small><p>{entry.data.outcome}</p></div>
				<div data-reveal><small>METHODS / SIGNALS</small><p>{entry.data.tags.join(' · ')}</p></div>
			</div>
		</section>

		<div class="case-body page-shell">
			<aside class="case-aside" data-reveal>
				<div class="case-mark" aria-hidden="true">
					<span>{String(entry.data.order).padStart(2, '0')}</span>
					<strong>WY</strong>
				</div>
				{entry.data.confidentiality && (
					<div class="confidentiality">
						<small>{t('workDetail.note')}</small>
						<p>{entry.data.confidentiality}</p>
					</div>
				)}
			</aside>
			<article class="prose" data-reveal>
				<Content />
			</article>
		</div>

		<nav class="next-project section-rule" aria-label={t('workDetail.next')}>
			<a class="page-shell" href={navUrl(`/work/${nextSlug}/`)}>
				<span>{t('workDetail.next')}</span>
				<strong>{nextProject.data.title}</strong>
				<span aria-hidden="true">→</span>
			</a>
		</nav>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.case-hero {
		padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 11vw, 10rem);
	}

	.back-link {
		display: inline-flex;
		gap: 0.6rem;
		align-items: center;
		color: var(--ink-soft);
		font-size: 0.78rem;
		font-weight: 650;
		text-decoration: none;
	}

	.back-link:hover {
		color: var(--signal-dark);
	}

	.case-title-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: end;
		margin-top: clamp(4rem, 9vw, 8rem);
	}

	.case-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
		margin-bottom: 1.75rem;
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.case-meta span:first-child {
		color: var(--signal-dark);
	}

	h1 {
		max-width: 14ch;
		font-family: var(--font-serif);
		font-size: var(--step-5);
		line-height: 0.95;
	}

	.case-dek {
		display: grid;
		justify-items: start;
		gap: 2rem;
		color: var(--ink-soft);
		font-size: var(--step-1);
	}

	.case-facts {
		padding-block: 2.5rem;
		background: var(--paper-deep);
	}

	.facts-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
	}

	.facts-grid > div {
		display: grid;
		gap: 0.85rem;
		padding-inline: clamp(1rem, 3vw, 2.5rem);
		border-right: 1px solid var(--rule);
	}

	.facts-grid > div:first-child { padding-left: 0; }
	.facts-grid > div:last-child { padding-right: 0; border-right: 0; }

	.facts-grid small,
	.confidentiality small {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.facts-grid p {
		font-size: 0.84rem;
		line-height: 1.55;
	}

	.case-body {
		display: grid;
		grid-template-columns: minmax(12rem, 0.42fr) minmax(0, 1fr) minmax(8rem, 0.2fr);
		gap: clamp(2rem, 6vw, 6rem);
		padding-block: clamp(5rem, 11vw, 10rem);
	}

	.case-aside {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}

	.case-mark {
		display: grid;
		grid-template-columns: 1fr 1fr;
		width: 8rem;
		aspect-ratio: 1;
		border: 1px solid var(--rule-strong);
		background:
			linear-gradient(90deg, transparent calc(50% - 0.5px), var(--rule) 0, var(--rule) calc(50% + 0.5px), transparent 0),
			linear-gradient(transparent calc(50% - 0.5px), var(--rule) 0, var(--rule) calc(50% + 0.5px), transparent 0),
			var(--paper-raised);
	}

	.case-mark span,
	.case-mark strong {
		display: grid;
		place-items: center;
		font-family: var(--font-mono);
	}

	.case-mark span {
		color: var(--signal-dark);
		font-size: 0.72rem;
	}

	.case-mark strong {
		grid-column: 2;
		grid-row: 2;
		font-size: 0.82rem;
	}

	.confidentiality {
		display: grid;
		gap: 0.8rem;
		padding-top: 1rem;
		border-top: 1px solid var(--rule-strong);
		color: var(--ink-soft);
		font-size: 0.72rem;
		line-height: 1.55;
	}

	.case-body article {
		max-width: 44rem;
	}

	.next-project a {
		display: grid;
		grid-template-columns: 10rem 1fr auto;
		gap: 2rem;
		align-items: center;
		padding-block: clamp(3rem, 7vw, 6rem);
		text-decoration: none;
	}

	.next-project a > span:first-child {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.next-project strong {
		font-family: var(--font-serif);
		font-size: var(--step-2);
		font-weight: 600;
		letter-spacing: -0.035em;
	}

	.next-project a > span:last-child {
		color: var(--signal-dark);
		font-size: 2rem;
		transition: transform var(--duration) var(--ease-out);
	}

	.next-project a:hover > span:last-child {
		transform: translateX(0.5rem);
	}

	@media (max-width: 56rem) {
		.case-title-grid,
		.case-body {
			grid-template-columns: 1fr;
		}

		.case-aside {
			display: grid;
			grid-template-columns: auto 1fr;
			align-items: start;
		}

		.facts-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}

		.facts-grid > div,
		.facts-grid > div:first-child,
		.facts-grid > div:last-child {
			padding: 0 0 1.5rem;
			border-right: 0;
			border-bottom: 1px solid var(--rule);
		}

		.facts-grid > div:last-child {
			padding-bottom: 0;
			border-bottom: 0;
		}
	}

	@media (max-width: 42rem) {
		h1 {
			font-size: clamp(3.2rem, 15vw, 5.3rem);
		}

		.case-aside {
			grid-template-columns: 1fr;
		}

		.next-project a {
			grid-template-columns: 1fr auto;
		}

		.next-project a > span:first-child {
			grid-column: 1 / -1;
		}
	}
</style>
