---
import { getCollection } from 'astro:content';
import ContactCTA from '../ContactCTA.astro';
import ProjectIndex from '../ProjectIndex.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const projects = (await getCollection('work'))
	.filter((entry) => entry.data.locale === locale)
	.sort((a, b) => a.data.order - b.data.order);
const experimentSlugs = new Set(['ai-agent-system', 'psyphiclaw', 'behaviorlens']);
const experiments = projects.filter((project) => experimentSlugs.has(project.id.split('/').at(-1) ?? ''));
const systems = projects.filter((project) => project.data.featured);
const studies = projects.filter((project) => !project.data.featured && !experiments.includes(project));
---

<BaseLayout locale={locale} title={t('work.metaTitle')} description={t('work.metaDesc')}>
	<main>
		<header class="archive-hero page-shell" data-reveal>
			<p class="eyebrow">{t('work.eyebrow')}</p>
			<div class="archive-grid">
				<h1>{t('work.title')}</h1>
				<div>
					<p>{t('work.intro')}</p>
					<ul class="legend" aria-label="Project status legend">
						<li>{t('work.legendDelivered')}</li>
						<li>{t('work.legendOperating')}</li>
						<li>{t('work.legendPrototype')}</li>
					</ul>
				</div>
			</div>
		</header>

		<section class="archive-list page-shell" aria-labelledby="systems-title">
			<header class="archive-section-heading" data-reveal>
				<p class="eyebrow">{t('work.systemsEyebrow')}</p>
				<h2 id="systems-title">{t('work.systemsTitle')}</h2>
			</header>
			<ProjectIndex projects={systems} {locale} illustrated />
		</section>

		<section class="archive-list studies page-shell" aria-labelledby="studies-title">
			<header class="archive-section-heading" data-reveal>
				<p class="eyebrow">{t('work.studiesEyebrow')}</p>
				<h2 id="studies-title">{t('work.studiesTitle')}</h2>
			</header>
			<ProjectIndex projects={studies} {locale} />
		</section>
		<section class="archive-list page-shell" aria-labelledby="experiments-title">
			<header class="archive-section-heading" data-reveal>
				<p class="eyebrow">{t('work.experimentsEyebrow')}</p>
				<h2 id="experiments-title">{t('work.experimentsTitle')}</h2>
				<p>{t('work.experimentsIntro')}</p>
			</header>
			<ProjectIndex projects={experiments} {locale} />
		</section>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.archive-hero {
		padding-block: clamp(5rem, 11vw, 10rem) clamp(4rem, 9vw, 8rem);
	}

	.archive-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: end;
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	h1 {
		max-width: 13ch;
		font-family: var(--font-display);
		font-size: var(--step-5);
		line-height: 1.15;
	}

	.archive-grid > div {
		display: grid;
		gap: 2.25rem;
		color: var(--ink-soft);
	}

	.legend {
		display: grid;
		gap: 0.55rem;
		padding: 0;
		list-style: none;
	}

	.legend li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-family: var(--font-mono);
		font-size: 0.65rem;
		letter-spacing: 0.05em;
	}

	.legend li::before {
		width: 0.55rem;
		height: 0.55rem;
		background: var(--signal);
		content: "";
	}

	.archive-list {
		padding-bottom: clamp(5rem, 10vw, 9rem);
	}

	.archive-list.studies {
		padding-top: clamp(2rem, 5vw, 4rem);
		padding-bottom: clamp(7rem, 13vw, 12rem);
	}

	.archive-section-heading {
		display: grid;
		grid-template-columns: minmax(16rem, 0.55fr) minmax(0, 1.45fr);
		gap: 3rem;
		align-items: end;
		margin-bottom: clamp(2.5rem, 6vw, 5rem);
	}

	.archive-section-heading h2 {
		max-width: 18ch;
		font-family: var(--font-display);
		font-size: var(--step-3);
		line-height: 1.05;
	}

	@media (max-width: 48rem) {
		.archive-grid,
		.archive-section-heading {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: clamp(3.4rem, 16vw, 5.5rem);
		}
	}
</style>
