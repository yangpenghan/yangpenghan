---
import { getCollection } from 'astro:content';
import { getRelativeLocaleUrl } from 'astro:i18n';
import ContactCTA from '../ContactCTA.astro';
import NoteList from '../NoteList.astro';
import ReadingPaths from '../ReadingPaths.astro';
import TopicMap from '../visuals/TopicMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = (await getCollection('notes'))
	.filter((entry) => entry.data.locale === locale)
	.sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || (b.data.updatedDate ?? b.data.publishDate).valueOf() - (a.data.updatedDate ?? a.data.publishDate).valueOf() || a.id.localeCompare(b.id));
const foundation = notes.find((note) => note.id === `${locale}/every-problem-is-technical`);
const topics = ['solution-engineering', 'agentic-ai', 'behavioral-intelligence', 'human-factors'] as const;
const groups = topics.map((topic) => ({
	topic,
	title: t(`notes.topic.${topic}.title`),
	body: t(`notes.topic.${topic}.body`),
	notes: notes.filter((note) => note.data.category === topic && note.id !== foundation?.id),
})).filter((group) => group.notes.length > 0);
---

<BaseLayout locale={locale} title={t('notes.metaTitle')} description={t('notes.metaDesc')}>
	<main>
		<header class="notes-hero page-shell" data-reveal>
			<p class="eyebrow">{t('notes.eyebrow')}</p>
			<div class="notes-heading">
				<h1>{t('notes.title')}</h1>
				<div>
					<p>{t('notes.intro')}</p>
					<a class="text-link" href="#reading-paths">{t('notes.readingPaths')}</a>
				</div>
			</div>
		</header>

		<div class="notes-archive page-shell">
      {foundation && <section class="foundation" id="core-argument" aria-labelledby="foundation-title">
        <p class="eyebrow">{locale === 'zh' ? '先读这一篇 / 核心主张' : 'Start here / Core argument'}</p>
        <div class="foundation-copy"><h2 id="foundation-title"><a href={getRelativeLocaleUrl(locale, 'notes/every-problem-is-technical/')}>{foundation.data.title}<span aria-hidden="true"> ↗</span></a></h2>
        <p>{foundation.data.description}</p></div>
        <TopicMap {locale} />
      </section>}
			<ReadingPaths {notes} {locale} />
			<p class="archive-label eyebrow">{locale === 'zh' ? `全部 ${notes.length} 篇 / 按议题浏览` : `All ${notes.length} essays / Browse by subject`}</p>
			{groups.map((group) => (
				<section class="topic-section" id={group.topic} aria-labelledby={`${group.topic}-title`}>
					<header class="topic-heading"><h2 id={`${group.topic}-title`}>{group.title}</h2><p>{group.body}</p></header>
					<NoteList notes={group.notes} {locale} />
				</section>
			))}
		</div>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.archive-label { margin-bottom: 2.5rem; }
  .foundation { padding: clamp(1.5rem, 4vw, 3rem); margin-bottom: 4rem; background: var(--paper-deep); border-top: 2px solid var(--author); scroll-margin-top: calc(var(--header-height) + 2rem); }
  .foundation h2 { margin-block: 1.5rem; font-size: var(--step-3); font-weight: 500; line-height: 1.35; }
  .foundation h2 a { text-decoration: none; }
  .foundation h2 a:hover { text-decoration: underline; text-underline-offset: .15em; }
  .foundation-copy > p:last-child { max-width: 48rem; color: var(--ink-soft); }
	.notes-hero {
		padding-block: clamp(5rem, 11vw, 10rem) clamp(4rem, 9vw, 8rem);
	}

	.notes-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: end;
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	h1 {
		max-width: 100%;
		font-family: var(--font-display);
		font-size: clamp(3rem, 5vw, 5rem);
		line-height: 1.12;
	}

	.notes-heading > div {
		display: grid;
		gap: 2rem;
		color: var(--ink-soft);
	}

	.topic-links { display: grid; gap: .75rem; }
	.topic-links a { display: flex; justify-content: space-between; gap: 1rem; padding-block: .5rem; border-bottom: 1px solid var(--rule); font-size: .88rem; text-decoration: none; }
	.topic-links span { color: var(--ink-soft); font-family: var(--font-mono); }
	.topic-section { scroll-margin-top: calc(var(--header-height) + 2rem); margin-bottom: clamp(4rem, 8vw, 7rem); }
	.topic-heading { display: grid; gap: 1.5rem; margin-bottom: 2.5rem; }
	.topic-heading h2 { font-family: var(--font-display); font-size: var(--step-2); line-height: 1.2; }
	.topic-heading p { max-width: 45rem; color: var(--ink-soft); }

	.notes-archive {
		padding-bottom: clamp(6rem, 12vw, 12rem);
	}

	@media (max-width: 48rem) {
		.notes-heading {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: clamp(2.4rem, 10vw, 3.5rem);
		}
	}

 .foundation { display: grid; grid-template-columns: minmax(0,1fr) minmax(0,1fr); gap: 2rem 3rem; align-items: center; }
 .foundation > .eyebrow { grid-column: 1 / -1; }
 @media(max-width:48rem) { .foundation { grid-template-columns: minmax(0,1fr); } }
</style>
