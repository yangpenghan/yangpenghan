---
import { getCollection } from 'astro:content';
import ContactCTA from '../ContactCTA.astro';
import NoteList from '../NoteList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const notes = (await getCollection('notes'))
	.filter((entry) => entry.data.locale === locale)
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const categories = [...new Set(notes.map((note) => note.data.categoryLabel))];
---

<BaseLayout locale={locale} title={t('notes.metaTitle')} description={t('notes.metaDesc')}>
	<main>
		<header class="notes-hero page-shell" data-reveal>
			<p class="eyebrow">{t('notes.eyebrow')}</p>
			<div class="notes-heading">
				<h1>{t('notes.title')}</h1>
				<div>
					<p>{t('notes.intro')}</p>
					<p class="categories">{categories.join(' / ')}</p>
				</div>
			</div>
		</header>

		<section class="notes-archive page-shell" aria-label={t('notes.eyebrow')}>
			<NoteList {notes} {locale} />
		</section>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.notes-hero {
		padding-block: clamp(5rem, 11vw, 10rem) clamp(4rem, 9vw, 8rem);
	}

	.notes-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.5fr);
		gap: clamp(3rem, 8vw, 8rem);
		align-items: end;
		margin-top: clamp(3rem, 7vw, 6rem);
	}

	h1 {
		max-width: 12ch;
		font-family: var(--font-serif);
		font-size: var(--step-5);
		line-height: 0.95;
	}

	.notes-heading > div {
		display: grid;
		gap: 2rem;
		color: var(--ink-soft);
	}

	.categories {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.notes-archive {
		padding-bottom: clamp(6rem, 12vw, 12rem);
	}

	@media (max-width: 48rem) {
		.notes-heading {
			grid-template-columns: 1fr;
		}

		h1 {
			font-size: clamp(3.4rem, 16vw, 5.5rem);
		}
	}
</style>
