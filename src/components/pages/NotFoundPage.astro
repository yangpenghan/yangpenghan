---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Locale, useTranslations } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
---

<BaseLayout locale={locale} title={t('404.metaTitle')} description={t('404.metaDesc')}>
	<main class="missing page-shell">
		<div data-reveal>
			<p class="eyebrow">{t('404.eyebrow')}</p>
			<h1>{t('404.title')}</h1>
			<p>{t('404.body')}</p>
			<p class="missing-reassure">{t('404.reassure')}</p>
			<figure class="missing-figure">
				<img
					src={import.meta.env.BASE_URL + 'assets/technical-adjustment.jpg'}
					alt={t('404.figAlt')}
					width="400"
					height="400"
					loading="lazy"
				/>
				<figcaption>{t('404.figCaption')}</figcaption>
			</figure>
			<div class="missing-links">
				<a class="text-link internal" href={navUrl('/')}>{t('404.home')}</a>
				<a class="text-link internal" href={navUrl('/work/')}>{t('404.work')}</a>
			</div>
		</div>
		<strong aria-hidden="true">404</strong>
	</main>
</BaseLayout>

<style>
	.missing {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 3rem;
		align-items: center;
		min-height: calc(100dvh - var(--header-height));
		padding-block: 5rem;
	}

	.missing > div {
		display: grid;
		justify-items: start;
		gap: 2rem;
	}

	h1 {
		max-width: 12ch;
		font-family: var(--font-display);
		font-size: var(--step-4);
	}

	.missing > div > p:not(.eyebrow) {
		color: var(--ink-soft);
	}

	.missing-reassure {
		font-weight: 600;
	}

	.missing-figure {
		margin: 0;
		max-width: 300px;
	}

	.missing-figure img {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--rule);
	}

	.missing-figure figcaption {
		margin-top: 0.75rem;
		font-size: 12px;
		line-height: 1.8;
		color: var(--ink-soft);
	}

	.missing-links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
	}

	.missing > strong {
		color: var(--signal);
		font-family: var(--font-display);
		font-size: clamp(8rem, 28vw, 28rem);
		font-weight: 600;
		letter-spacing: -0.1em;
		line-height: 0.7;
		opacity: 0.16;
	}

	@media (max-width: 48rem) {
		.missing {
			grid-template-columns: 1fr;
		}
	}
</style>
