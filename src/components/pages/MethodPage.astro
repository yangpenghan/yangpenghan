---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ContactCTA from '../ContactCTA.astro';
import Toolbox from '../Toolbox.astro';
import ResourceLinks from '../ResourceLinks.astro';
import ReframeExplorer from '../visuals/ReframeExplorer.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';
import type { UIKey } from '../../i18n/ui';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const stages = [1, 2, 3, 4].map((index) => ({
	title: t(`index.method${index}Title` as UIKey),
 icon: ['question', 'reframe', 'experiment', 'evidence'][index - 1],
	body: t(`index.method${index}Body` as UIKey),
}));
const copy = locale === 'zh' ? {
	title: '解题之前，\n先检查题目。',
	description: '杨朋翰的元思维与工具箱：分开目标和方案，拆解条件与关系，设计能区分解释的试验，检验自己的判断。',
	intro: '“所有问题都是技术性问题”，落实到我的工作里，首先是检查问题怎么被定义。这里展开我怎样提问、怎样判断自己的解释，以及用哪些工具把想法变成可以检查的东西。',
	startTitle: '开始时，我需要了解三件事。',
	start: [
		['你要做成什么', '谁会使用结果？接下来要做哪个决定？做到什么程度才算有用？'],
		['你已经试过什么', '已有的方案、观察、数据或原型，比一份精修的介绍更能帮助我理解问题。'],
		['我们有哪些条件', '时间、预算、能接触的用户、可用工具，以及哪些人需要参与判断。'],
	],
	stepsTitle: '元思维：连提问方式也要检查。',
	outputs: [
		'留下：双方能确认的问题描述、范围和判断标准。',
		'留下：已有观察、可能原因，以及最需要补的证据。',
		'留下：可以检查的研究方案、模拟体验或工具原型。',
		'留下：结果、使用方法、未解决问题和后续验证安排。',
	],
	toolsTitle: '重构一次问题，行动就会不同。',
	toolsIntro: '下面是我从实践中归纳的几种转换。新的问法需要继续服务于原目标；不能因为它更容易回答，就把原来的问题丢掉。',
	checkTitle: '决定继续之前，先检查办法有没有用。',
	checkBody: '研究需要回到原始记录，设计建议需要后续验证，工具需要放进真实任务中试用。如果证据不足，我会说明缺在哪里。一次小范围检查已经回答问题，就可以在这里结束；仍有值得解决的部分，再讨论下一步投入。',
	workLink: '看具体案例',
} : {
	title: 'Before the answer,\nexamine the question.',
	description: 'Working with Will Yang: clarify the goal and constraints, revisit the question, try available tools, then check and hand over the result.',
	intro: '“Every problem is a technical problem” begins, in my work, with examining how the question is defined. Here is how I ask questions, test my own explanations, and choose tools to make an idea inspectable.',
	startTitle: 'Three things help us start.',
	start: [
		['What you want to achieve', 'Who will use the result? What decision comes next? What would make this useful?'],
		['What you have already tried', 'Existing plans, observations, data, or a prototype help me understand the problem.'],
		['What we can work with', 'Time, budget, access to users, available tools, and the people who need to take part.'],
	],
	stepsTitle: 'Metacognition: examine how the question is framed.',
	outputs: [
		'Output: an agreed question, scope, and criteria for judging the result.',
		'Output: observations, possible causes, and the evidence we most need next.',
		'Output: a study plan, simulated experience, or tool prototype we can inspect.',
		'Output: results, instructions, open issues, and a plan for further checks.',
	],
	toolsTitle: 'Reframing changes what we can do next.',
	toolsIntro: 'These are shifts I draw from my practice. A new question must still serve the original goal. Being easier to answer is not enough.',
	checkTitle: 'Check whether the approach helped before investing further.',
	checkBody: 'Research needs its source records, design recommendations need a follow-up check, and tools need real tasks. If evidence is missing, I explain the gap. A small check may be enough to answer the question; further investment follows from what remains worth solving.',
	workLink: 'Read the cases',
};
---

<BaseLayout {locale} title={`${t('nav.method')} | ${t('nav.brand')}`} description={copy.description}>
	<main>
		<header class="method-hero page-shell">
			<div><p class="eyebrow">{t('nav.method')}</p><h1>{copy.title}</h1></div>
			<div><p>{copy.intro}</p><nav class="method-links" aria-label={locale === 'zh' ? '方法页导航' : 'Approach page navigation'}>
            <a href="#start-title">{locale === 'zh' ? '怎样开始' : 'Getting started'}</a>
            <a href="#reframe-title">{locale === 'zh' ? '案例推演' : 'Worked examples'}</a>
            <a href="#toolbox">{locale === 'zh' ? '工具箱' : 'Toolbox'}</a>
            <a href="#materials">{locale === 'zh' ? '取用模板' : 'Get templates'}</a>
            </nav></div>
		</header>
		<section class="section-rule" aria-labelledby="start-title">
			<div class="page-shell">
				<h2 id="start-title">{copy.startTitle}</h2>
				<ul class="start-list">{copy.start.map(([title, body]) => <li><h3>{title}</h3><p>{body}</p></li>)}</ul>
			</div>
		</section>

		<section class="section-rule" aria-labelledby="reframe-title"><div class="page-shell"><h2 id="reframe-title">{copy.toolsTitle}</h2><p class="section-intro">{copy.toolsIntro}</p><ReframeExplorer {locale} id="method-reframe" /></div></section>
		<section class="stages section-rule" aria-labelledby="steps-title">
			<div class="page-shell">
				<h2 id="steps-title">{copy.stepsTitle}</h2>
				<ol class="stage-list">{stages.map((stage, index) => (
					<li><span class="stage-number"><img src={`${import.meta.env.BASE_URL}assets/brand/icons/${stage.icon}.svg`} alt="" width="40" height="40" loading="lazy" />{String(index + 1).padStart(2, '0')}</span><div><h3>{stage.title}</h3><p>{stage.body}</p><p class="output">{copy.outputs[index]}</p></div></li>
				))}</ol>
			</div>
		</section>

		<Toolbox {locale} />
		<section class="section-rule" aria-labelledby="check-title">
			<div class="page-shell"><h2 id="check-title">{copy.checkTitle}</h2><p class="section-intro">{copy.checkBody}</p><a class="text-link internal" href={navUrl('/work/')}>{copy.workLink}</a></div>
		</section>
        <div class="page-shell"><ResourceLinks {locale} ids={['evidence-trace', 'study-preparation', 'agent-workload', 'research-brief-skill']} /></div>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
	.method-hero { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(18rem, .6fr); gap: clamp(2rem, 4vw, 4rem); align-items: end; padding-block: clamp(2.5rem, 5vw, 4.5rem); }
	h1 { margin-top: 1.5rem; font-family: var(--font-display); font-size: clamp(2.3rem, 4vw, 4rem); line-height: 1.3; white-space: pre-line; }
	.method-hero > div > p:not(.eyebrow) { color: var(--ink-soft); font-size: var(--step-1); }
	section { padding-block: clamp(2.5rem, 5vw, 4rem); }
	h2 { max-width: 26ch; margin-bottom: 1.5rem; font-family: var(--font-display); font-size: var(--step-3); line-height: 1.2; }
	h3 { margin-bottom: 1rem; font-family: var(--font-display); font-size: var(--step-1); }
	li p, .section-intro { color: var(--ink-soft); }
	.section-intro { max-width: 48rem; margin-block: 0 2rem; }
	.start-list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; padding: 0; list-style: none; }
	.start-list li { padding-top: 1.5rem; border-top: 1px solid var(--rule-strong); }
	.stages { background: var(--paper-deep); }
	.stage-list { padding: 0; list-style: none; }
	.stage-list li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 2rem; padding-block: 2rem; border-top: 1px solid var(--rule-strong); }
	.stage-number { color: var(--signal-dark); font-family: var(--font-mono); }
	.stage-list p { max-width: 48rem; }
	.output { margin-top: 1.25rem; font-size: .9rem; }
	@media (max-width: 52rem) { .method-hero, .start-list { grid-template-columns: 1fr; } h1 { font-size: clamp(2.3rem, 8vw, 3.5rem); } }
	@media (max-width: 32rem) { .stage-list li { grid-template-columns: 1fr; gap: 1rem; } }
.stage-number { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }
 :global(.theme-dark) .stage-number img { filter: brightness(0) invert(1); }
.method-links { display: flex; flex-wrap: wrap; gap: .25rem 1rem; margin-top: 1rem; } .method-links a { display: inline-flex; min-height: 2.75rem; align-items: center; font-size: .875rem; color: var(--signal-dark); text-underline-offset: .25em; }
</style>
