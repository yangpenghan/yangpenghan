---
import ContactCTA from '../ContactCTA.astro';
import PublicSlide from '../visuals/PublicSlide.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n';
import type { UIKey } from '../../i18n/ui';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const base = import.meta.env.BASE_URL;
const stories = [1, 2, 3, 4].map((index) => ({
	year: t(`about.story${index}Year` as UIKey),
	title: t(`about.story${index}Title` as UIKey),
	body: t(`about.story${index}Body` as UIKey),
}));
const practices = [1, 2, 3, 4].map((index) => ({
	title: t(`about.practice${index}` as UIKey),
	body: t(`about.practice${index}Body` as UIKey),
}));
const principles = [1, 2, 3].map((index) => ({
	title: t(`about.principle${index}` as UIKey),
	body: t(`about.principle${index}Body` as UIKey),
}));
const talks = [6, 5, 4, 1, 2, 3].map((index) => ({
	year: t(`index.talk${index}Year` as UIKey),
	venue: t(`index.talk${index}Venue` as UIKey),
	topic: t(`index.talk${index}Topic` as UIKey),
	slides: index === 5 ? `${base}talks/2020-medical-device-hf-safety.pdf` : undefined,
}));
---

<BaseLayout locale={locale} title={t('about.metaTitle')} description={t('about.metaDesc')}>
	<main>
		<header class="about-hero page-shell">
			<div data-reveal>
				<p class="eyebrow">{t('about.eyebrow')}</p>
				<h1>{t('about.title')}</h1>
                <nav class="profile-links" aria-label={locale === 'zh' ? '了解我' : 'Explore my background'}>
                    <a href="#professional-profile">{locale === 'zh' ? '简介与合作' : 'Profile & collaboration'}</a>
                    <a href="#story-title">{locale === 'zh' ? '工作经历' : 'Background'}</a>
                    <a href="#talks-title">{locale === 'zh' ? '演讲与资料' : 'Talks & materials'}</a>
                </nav>
			</div>
			<div class="about-intro" data-reveal>
				<img src={`${base}assets/portrait.jpg`} alt={t('index.portraitAlt')} width="480" height="620" />
				<p>{t('about.intro')}</p>
			</div>
		</header>

        <section class="professional-profile page-shell" id="professional-profile" aria-labelledby="profile-title">
            <h2 id="profile-title">{locale === 'zh' ? '给合作方的一页简介' : 'A profile for collaborators'}</h2>
            <div class="profile-grid">
                <div><p>{locale === 'zh' ? '我目前负责 Noldus 中国咨询与业务拓展，参与方法设计、关键项目交付与团队能力建设。研究经验涉及金融、包装、汽车、医疗器械与服务机器人；个人工具实践围绕 AI 工作流、知识检索与行为数据处理。' : 'I lead Consulting and Business Development at Noldus China, contributing to method design, key project delivery, and team capability. My research spans finance, packaging, automotive, medical devices, and service robots. My personal tool experiments focus on AI workflows, knowledge retrieval, and behavioral data.'}</p>
                <p>{locale === 'zh' ? '企业咨询通过 Noldus 开展。案例页分别说明我的职责、团队成果与可公开的范围。' : 'Enterprise consulting is conducted through Noldus. Each case distinguishes my role, collective outcomes, and what can be shared publicly.'}</p></div>
                <div class="profile-materials">
                    <a href={`${base}resources/${locale}/will-yang-bio.md`} download>{locale === 'zh' ? '下载专业简介（Markdown）' : 'Download professional bio (Markdown)'}</a>
                    <a href={`${base}assets/portrait.jpg`} download>{locale === 'zh' ? '下载肖像（JPG）' : 'Download portrait (JPG)'}</a>
                    <a href="#contact">{locale === 'zh' ? '联系我讨论合作或交流' : 'Contact me about collaboration or a talk'}</a>
                </div>
            </div>
        </section>

		<section class="story section-rule" aria-labelledby="story-title">
			<div class="page-shell story-grid">
				<header data-reveal>
					<p class="eyebrow">{locale === 'zh' ? '工作经历' : 'Background'}</p>
					<h2 id="story-title">{t('about.storyTitle')}</h2>
				</header>
				<ol>
					{
						stories.map((item) => (
							<li data-reveal>
								<time>{item.year}</time>
								<div><h3>{item.title}</h3><p>{item.body}</p></div>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="practice section-rule" aria-labelledby="practice-title">
			<div class="page-shell">
				<header data-reveal>
					<p class="eyebrow">{t('about.practiceEyebrow')}</p>
					<h2 id="practice-title">{t('about.practiceTitle')}</h2>
				</header>
				<div class="practice-grid">
					{
						practices.map((item, index) => (
							<div data-reveal>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<h3>{item.title}</h3>
								<p>{item.body}</p>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="talks section-rule" aria-labelledby="talks-title">
			<div class="page-shell">
				<p class="eyebrow">{t('index.talksEyebrow')}</p>
				<h2 id="talks-title">{t('index.talksTitle')}</h2>
                <div class="organizer-note">
                    <h3>{locale === 'zh' ? '如果你在策划一次交流' : 'If you are organizing a conversation'}</h3>
                    <p>{locale === 'zh' ? '可以从这三个议题开始：研究怎样及时影响设计、观察怎样变成可追溯的判断、Agent 是否真的减少人工负担。它们分别适合产品与设计团队、研究同行，以及探索 AI 工作方式的团队。' : 'Three starting points: bringing research into design decisions, turning observations into traceable judgments, and testing whether agents reduce human workload. These suit product and design teams, research peers, and teams exploring AI at work, respectively.'}</p>
                    <p>{locale === 'zh' ? '来信时写明听众、希望讨论的问题与活动时间；形式和范围再一起确定。简介和肖像可从上方下载，以下保留已有公开分享与原始材料。' : 'Include the audience, the question you want to explore, and the event date. We can agree on scope and format from there. Download the bio and portrait above; past public talks and original material follow.'}</p>
                </div>
				<div class="talk-evidence"><PublicSlide {locale} /></div>
				<ol>{talks.map((talk) => (
					<li><time>{talk.year}</time><div><h3>{talk.topic}</h3><p>{talk.venue}</p>{talk.slides && <a class="text-link" href={talk.slides}>{t('index.talkSlides')}</a>}</div></li>
				))}</ol>
			</div>
		</section>

		<section class="principles section-rule" aria-labelledby="principles-title">
			<div class="page-shell principles-grid">
				<header data-reveal>
					<p class="eyebrow">{t('about.principlesEyebrow')}</p>
					<h2 id="principles-title">{locale === 'zh' ? '什么会改变我的选择。' : 'What changes my choice.'}</h2>
				</header>
				<ol>
					{
						principles.map((item, index) => (
							<li data-reveal>
								<span>{String(index + 1).padStart(2, '0')}</span>
								<div><h3>{item.title}</h3><p>{item.body}</p></div>
							</li>
						))
					}
				</ol>
			</div>
		</section>


		<section class="education section-rule">
			<div class="page-shell education-grid" data-reveal>
				<p class="eyebrow">{t('about.education')}</p>
				<p>{t('about.educationBody')}</p>
			</div>
		</section>
	</main>
	<ContactCTA {locale} />
</BaseLayout>

<style>
 .talk-evidence { margin-block: 3rem; }
	.about-hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: start;
		padding-block: clamp(2.5rem, 5vw, 4.5rem);
	}

	.about-hero h1 {
		max-width: 100%;
		margin-top: 1.5rem;
		font-family: var(--font-display);
		font-size: clamp(2.5rem, 4vw, 4rem);
		line-height: 1.3;
		white-space: pre-line;
	}

	.about-intro {
		display: grid;
		gap: 1.5rem;
	}

	.about-intro img {
		width: 9rem;
		height: auto;
		aspect-ratio: 1;
		border: 1px solid var(--rule-strong);
		object-fit: cover;
		object-position: center 25%;
		filter: grayscale(0.3) contrast(1.05);
	}

	.about-intro p {
		color: var(--ink-soft);
		font-size: var(--step-0);
	}

	.story,
	.practice,
	.principles,
	.talks {
		padding-block: clamp(3rem, 6vw, 5rem);
	}

	.story-grid,
	.principles-grid {
		display: grid;
		grid-template-columns: minmax(18rem, 0.7fr) minmax(0, 1.3fr);
		gap: clamp(4rem, 9vw, 9rem);
	}

	.story h2,
	.practice h2,
	.principles h2 {
		max-width: 13ch;
		margin-top: 2rem;
		font-family: var(--font-display);
		font-size: var(--step-3);
		white-space: pre-line;
	}

	.story ol,
	.principles ol {
		padding: 0;
		border-top: 1px solid var(--rule-strong);
		list-style: none;
	}

	.story li,
	.principles li {
		display: grid;
		grid-template-columns: 7rem 1fr;
		gap: 2rem;
		padding-block: 2.25rem;
		border-bottom: 1px solid var(--rule);
	}

	.story time,
	.principles li > span,
	.practice-grid span {
		color: var(--signal-dark);
		font-family: var(--font-mono);
		font-size: 0.68rem;
	}

	.story li div,
	.principles li div {
		display: grid;
		gap: 0.85rem;
	}

	.story h3,
	.principles h3,
	.practice h3 {
		font-family: var(--font-display);
		font-size: var(--step-1);
		line-height: 1.25;
	}

	.story li p,
	.principles li p,
	.practice-grid p {
		color: var(--ink-soft);
		font-size: 0.88rem;
	}

	.practice {
		background: var(--paper-deep);
	}

	.practice header {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 3rem;
		align-items: start;
		margin-bottom: clamp(4rem, 9vw, 8rem);
	}

	.practice h2 {
		max-width: 19ch;
		margin-top: 0;
		font-size: var(--step-4);
	}

	.practice-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--rule-strong);
		border-left: 1px solid var(--rule-strong);
	}

	.practice-grid > div {
		display: grid;
		grid-template-columns: 3rem 1fr;
		gap: 1rem;
		padding: clamp(1.5rem, 4vw, 3rem);
		border-right: 1px solid var(--rule-strong);
		border-bottom: 1px solid var(--rule-strong);
	}

	.practice-grid h3,
	.practice-grid p {
		grid-column: 2;
	}

	.education {
		padding-block: clamp(3rem, 7vw, 6rem);
		background: var(--inverse-bg);
		color: var(--inverse-ink);
	}

	.education-grid {
		display: grid;
		grid-template-columns: 1fr 2fr;
		gap: 3rem;
	}

	.education .eyebrow {
		color: var(--inverse-signal);
	}

	.education-grid > p:last-child {
		font-family: var(--font-display);
		font-size: var(--step-1);
		line-height: 1.5;
		white-space: pre-line;
	}

	.talks h2 { margin-block: 2rem 3rem; font-family: var(--font-display); font-size: var(--step-3); }
	.talks ol { padding: 0; list-style: none; }
	.talks li { display: grid; grid-template-columns: 4rem minmax(0, 1fr); gap: 1.5rem; padding-block: 1.5rem; border-top: 1px solid var(--rule); }
	.talks time { color: var(--signal-dark); font-family: var(--font-mono); }
	.talks h3 { font-size: var(--step-1); }
	.talks p { margin-block: .5rem; color: var(--ink-soft); }

	@media (max-width: 52rem) {
		.about-hero,
		.story-grid,
		.principles-grid,
		.practice header,
		.education-grid {
			grid-template-columns: 1fr;
		}

		.about-hero h1 {
			font-size: clamp(2.3rem, 10vw, 3rem);
		}

		.practice-grid {
			grid-template-columns: 1fr;
		}

		.practice h2 {
			font-size: clamp(2.4rem, 12vw, 5rem);
		}

	}

	@media (max-width: 32rem) {
		.story li,
		.principles li {
			grid-template-columns: 1fr;
			gap: 0.75rem;
		}
	}
.profile-links { display: flex; flex-wrap: wrap; gap: .25rem 1.25rem; margin-top: 1.5rem; }
    .profile-links a, .profile-materials a { display: inline-flex; align-items: center; min-height: 2.75rem; font-size: .95rem; color: var(--signal-dark); text-underline-offset: .25em; }
    .professional-profile { padding-block: 2rem 3rem; }
    .professional-profile h2 { font-size: var(--step-2); margin-bottom: 1.5rem; }
    .profile-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(0,.8fr); gap: 2rem; border-top: 1px solid var(--rule-strong); padding-top: 1.5rem; }
    .profile-grid p { max-width: 48rem; color: var(--ink-soft); }
    .profile-grid p + p { margin-top: 1rem; font-size: .95rem; }
    .profile-materials { display: flex; flex-direction: column; align-items: start; gap: .5rem; }
    .organizer-note { max-width: 50rem; margin-top: 2rem; }
    .organizer-note h3 { font-size: 1.2rem; }
    .organizer-note p { margin-top: 1rem; color: var(--ink-soft); }
    @media(max-width:48rem) { .profile-grid { grid-template-columns: 1fr; } }
</style>
