---
import { useTranslations, type Locale } from '../i18n';
import CopyText from './CopyText.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const noldusEmail = 'penghan.yang@noldus.com';
const gmail = 'yangpenghan1988@gmail.com';
const consultingSubject = locale === 'zh' ? '项目合作讨论' : 'Consulting inquiry';
const personalSubject = locale === 'zh' ? '想和你讨论一个问题' : 'A hard problem worth discussing';
---

<aside class="contact-section" id="contact" aria-labelledby="contact-title">
	<div class="page-shell contact-grid" data-reveal>
		<div>
			<p class="eyebrow">{t('cta.eyebrow')}</p>
			<h2 id="contact-title">{t('cta.title')}</h2>
		</div>
		<div class="contact-copy">
			<p>{t('cta.body')}</p>
			<div class="contact-links">
				<a class="primary-link" href={`mailto:${noldusEmail}?subject=${encodeURIComponent(consultingSubject)}`}>
					{t('cta.button')} <span aria-hidden="true">↗</span>
				</a>
				<div class="email-address"><span>{noldusEmail}</span><CopyText value={noldusEmail} {locale} /></div>
				<a class="secondary-link" href={`mailto:${gmail}?subject=${encodeURIComponent(personalSubject)}`}>
					{t('cta.personal')}
				</a>
				<div class="email-address"><span>{gmail}</span><CopyText value={gmail} {locale} /></div>
				<a class="secondary-link" href="https://www.linkedin.com/in/thereisawillyang">
					{t('cta.linkedin')}
				</a>
			</div>
		</div>
	</div>
</aside>

<style>
	.contact-section {
		padding-block: clamp(3rem, 6vw, 5rem);
		border-top: 1px solid var(--rule);
	}

	.contact-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: clamp(2rem, 5vw, 5rem);
		align-items: end;
	}

	h2 {
		max-width: 18ch;
		margin-top: 2rem;
		font-family: var(--font-display);
		font-size: var(--step-3);
		line-height: 1.3;
	}

	.contact-copy {
		display: grid;
		gap: 2rem;
		color: var(--ink-soft);
	}

	.contact-links {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
	}
	.email-address { display: grid; gap: .25rem; margin-bottom: .75rem; min-width: 0; font-size: .875rem; overflow-wrap: anywhere; }

	.primary-link,
	.secondary-link {
		display: inline-flex;
		min-height: 3rem;
		align-items: center;
		justify-content: center;
		padding: 0.65rem 1rem;
		font-size: 0.88rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background var(--duration) ease,
			color var(--duration) ease,
			transform var(--duration) ease;
	}

	.primary-link {
		gap: 0.65rem;
		background: var(--signal);
		color: var(--paper-raised);
	}

	.secondary-link {
		border: 1px solid var(--rule-strong);
	}

	.primary-link:hover,
	.secondary-link:hover {
		background: var(--author);
		color: var(--paper-raised);
	}

	.primary-link:active,
	.secondary-link:active {
		transform: translateY(1px);
	}

	@media (max-width: 48rem) {
		.contact-grid {
			grid-template-columns: 1fr;
		}
	}
:global(.theme-dark) .primary-link, :global(.theme-dark) .secondary-link:hover { color: var(--paper); }
</style>
