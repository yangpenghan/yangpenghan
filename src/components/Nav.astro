---
import { getRelativeLocaleUrl } from 'astro:i18n';
import BrandIdentity from './BrandIdentity.astro';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Locale, type UIKey } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items: Array<{ key: UIKey; path: string }> = [
	{ key: 'nav.work', path: '/work/' },
	{ key: 'nav.method', path: '/method/' },
	{ key: 'nav.notes', path: '/notes/' },
	{ key: 'nav.about', path: '/about/' },
];
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const corePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^en\/?/, '');
const normalizedPath = `/${corePath}`.replace(/\/+/g, '/');
const switchLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const switchUrl = getRelativeLocaleUrl(switchLocale, corePath);
const isCurrent = (path: string) => normalizedPath === path || normalizedPath.startsWith(path);
---

<header class="masthead">
	<nav class="page-shell" aria-label={t('nav.home')}>
		<a class="brand" href={navUrl('/overview/')} aria-label={locale === 'zh' ? '返回主页总览' : 'Back to the overview'}>
			<span class="brand-signature"><BrandIdentity kind="signature" {locale} /></span>
   <span class="brand-mobile"><span class="mobile-mark"><BrandIdentity /></span><span>{t('nav.brand')}</span></span>
		</a>

		<div class="nav-links"><a href={navUrl('/')} data-interactive-home>{locale === 'zh' ? '互动主页' : 'Interactive home'}</a>
			{
				items.map((item) => (
					<a href={navUrl(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
						{t(item.key)}
					</a>
				))
			}
		</div>

		<div class="nav-tools">
			<a class="contact-link" href={normalizedPath.includes('404') ? `${navUrl('/overview/')}#contact` : '#contact'}>{t('nav.contact')}</a>
			<a class="language" href={switchUrl} aria-label={t('nav.language')} lang={switchLocale === 'zh' ? 'zh-CN' : 'en'}>
				{switchLocale === 'zh' ? '中' : 'EN'}
			</a>
			<ThemeToggle {locale} />
		</div>
	</nav>
</header>

<style>
	.masthead {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
		background: color-mix(in srgb, var(--paper) 90%, transparent);
		backdrop-filter: blur(16px);
	}

	nav {
		display: grid;
		grid-template-columns: minmax(12rem, 1fr) auto minmax(10rem, .6fr);
		align-items: center;
		height: var(--header-height);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.7rem;
		text-decoration: none;
	}

 .brand-signature { width: 13rem; }
 .brand-mobile { display: none; align-items: center; gap: .6rem; font-size: .95rem; font-weight: 500; }
 .mobile-mark { width: 2.5rem; }

	.nav-links {
		display: flex;
		align-items: stretch;
		height: 100%;
	}

	.nav-links a,
	.language {
		position: relative;
		display: flex;
		align-items: center;
		padding-inline: 1rem;
		color: var(--ink-soft);
		font-size: 0.88rem;
		font-weight: 650;
		text-decoration: none;
		transition: color var(--duration) ease;
	}

	.nav-links a::after {
		position: absolute;
		bottom: -1px;
		left: 1rem;
		right: 1rem;
		height: 2px;
		background: var(--signal);
		content: "";
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--duration) var(--ease-out);
	}

	.nav-links a:hover,
	.nav-links a[aria-current='page'] {
		color: var(--ink);
	}

	.nav-links a:hover::after,
	.nav-links a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.nav-tools {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 0.2rem;
	}

	.language {
		height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.05em;
	}

	.language:hover {
		color: var(--signal-dark);
	}
	.contact-link { display: inline-flex; align-items: center; justify-content: center; min-height: 2.75rem; padding-inline: .65rem; font-size: .875rem; color: var(--signal-dark); text-decoration: none; }
	.contact-link:hover { text-decoration: underline; text-underline-offset: .25em; }
	@media (max-width: 23rem) { .language { padding-inline: .5rem; } .brand-mobile { gap: .35rem; font-size: .875rem; } .mobile-mark { width: 2rem; } }

	@media (max-width: 56rem) {
		.masthead {
			backdrop-filter: none;
		}

		nav {
			grid-template-columns: 1fr auto;
		}

		.brand-signature { display: none; }
  .brand-mobile { display: flex; }

		.nav-links {
			order: 3;
			position: fixed;
			bottom: max(0.75rem, env(safe-area-inset-bottom));
			left: 50%;
			width: max-content;
			max-width: calc(100vw - 1.5rem);
			height: 3rem;
			padding-inline: 0.25rem;
			border: 1px solid var(--rule-strong);
			background: color-mix(in srgb, var(--paper-raised) 94%, transparent);
			box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--ink) 12%, transparent);
			backdrop-filter: blur(16px);
			transform: translateX(-50%);
		}

		.nav-links a {
			white-space: nowrap;
			padding-inline: 0.9rem;
			font-size: 0.78rem;
		}

		.nav-links a::after {
			bottom: 0;
			left: 0.9rem;
			right: 0.9rem;
		}
	}

	@media (max-width: 23rem) {
		.nav-links a {
			padding-inline: 0.52rem;
			font-size: 0.72rem;
		}
	}
</style>
