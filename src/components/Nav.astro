---
import { getRelativeLocaleUrl } from 'astro:i18n';
import ThemeToggle from './ThemeToggle.astro';
import { useTranslations, type Locale, type UIKey } from '../i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const items: Array<{ key: UIKey; path: string }> = [
	{ key: 'nav.work', path: '/work/' },
	{ key: 'nav.notes', path: '/notes/' },
	{ key: 'nav.about', path: '/about/' },
];
const navUrl = (path: string) => getRelativeLocaleUrl(locale, path.replace(/^\//, ''));
const corePath = Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^en\/?/, '');
const normalizedPath = `/${corePath}`.replace(/\/+/g, '/');
const switchLocale: Locale = locale === 'zh' ? 'en' : 'zh';
const switchUrl = getRelativeLocaleUrl(switchLocale, corePath);
const isCurrent = (path: string) => normalizedPath === path || normalizedPath.startsWith(path);
---

<header class="masthead">
	<nav class="page-shell" aria-label={t('nav.home')}>
		<a class="brand" href={navUrl('/')} aria-label={`${t('nav.brand')} — ${t('nav.home')}`}>
			<span class="monogram" aria-hidden="true">WY</span>
			<span class="brand-name">
				<strong>{t('nav.brand')}</strong>
				<small>{t('nav.brandAlt')}</small>
			</span>
		</a>

		<div class="nav-links">
			{
				items.map((item) => (
					<a href={navUrl(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>
						{t(item.key)}
					</a>
				))
			}
		</div>

		<div class="nav-tools">
			<a class="language" href={switchUrl} aria-label={t('nav.language')} lang={switchLocale === 'zh' ? 'zh-CN' : 'en'}>
				{switchLocale === 'zh' ? '中' : 'EN'}
			</a>
			<ThemeToggle {locale} />
		</div>
	</nav>
</header>

<style>
	.masthead {
		position: sticky;
		top: 0;
		z-index: var(--z-header);
		border-bottom: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
		background: color-mix(in srgb, var(--paper) 90%, transparent);
		backdrop-filter: blur(16px);
	}

	nav {
		display: grid;
		grid-template-columns: minmax(10rem, 1fr) auto minmax(10rem, 1fr);
		align-items: center;
		height: var(--header-height);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		justify-self: start;
		gap: 0.7rem;
		text-decoration: none;
	}

	.monogram {
		display: grid;
		width: 2.75rem;
		height: 2.75rem;
		place-items: center;
		border: 1px solid var(--ink);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: -0.08em;
		transition:
			background var(--duration) ease,
			color var(--duration) ease;
	}

	.brand:hover .monogram {
		background: var(--ink);
		color: var(--paper);
	}

	.brand-name {
		display: flex;
		flex-direction: column;
		line-height: 1.12;
	}

	.brand-name strong {
		font-size: 0.9rem;
	}

	.brand-name small {
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: 0.62rem;
		letter-spacing: 0.02em;
	}

	.nav-links {
		display: flex;
		align-items: stretch;
		height: 100%;
	}

	.nav-links a,
	.language {
		position: relative;
		display: flex;
		align-items: center;
		padding-inline: 1rem;
		color: var(--ink-soft);
		font-size: 0.88rem;
		font-weight: 650;
		text-decoration: none;
		transition: color var(--duration) ease;
	}

	.nav-links a::after {
		position: absolute;
		bottom: -1px;
		left: 1rem;
		right: 1rem;
		height: 2px;
		background: var(--signal);
		content: "";
		transform: scaleX(0);
		transform-origin: left;
		transition: transform var(--duration) var(--ease-out);
	}

	.nav-links a:hover,
	.nav-links a[aria-current='page'] {
		color: var(--ink);
	}

	.nav-links a:hover::after,
	.nav-links a[aria-current='page']::after {
		transform: scaleX(1);
	}

	.nav-tools {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: 0.2rem;
	}

	.language {
		height: 2.75rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.05em;
	}

	.language:hover {
		color: var(--signal-dark);
	}

	@media (max-width: 48rem) {
		.masthead {
			backdrop-filter: none;
		}

		nav {
			grid-template-columns: 1fr auto;
		}

		.brand-name {
			display: none;
		}

		.nav-links {
			order: 3;
			position: fixed;
			bottom: max(0.75rem, env(safe-area-inset-bottom));
			left: 50%;
			height: 3rem;
			padding-inline: 0.25rem;
			border: 1px solid var(--rule-strong);
			background: color-mix(in srgb, var(--paper-raised) 94%, transparent);
			box-shadow: 0 0.75rem 2rem color-mix(in srgb, var(--ink) 12%, transparent);
			backdrop-filter: blur(16px);
			transform: translateX(-50%);
		}

		.nav-links a {
			padding-inline: 0.9rem;
			font-size: 0.78rem;
		}

		.nav-links a::after {
			bottom: 0;
			left: 0.9rem;
			right: 0.9rem;
		}
	}

	@media (max-width: 23rem) {
		.nav-links a {
			padding-inline: 0.68rem;
		}
	}
</style>
